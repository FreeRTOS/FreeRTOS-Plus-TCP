{
    "ENTRY": "DHCPv6SubOption",
    "OPTION_LOOP_BOUND": 10,
    "CBMCFLAGS":
    [
      "--nondet-static --flush",
      "--unwind 10",
      "--unwindset __CPROVER_file_local_FreeRTOS_DHCPv6_c_prvDHCPv6_subOption.0:{OPTION_LOOP_BOUND}"
    ],
    "INSTFLAGS":
    [
        "--malloc-may-fail"
    ],
    "OPT":
    [
      "--export-file-local-symbols"
    ],
    "DEF":
    [
      "ipconfigUSE_DHCPv6=1"
    ],
    "OBJS":
    [
      "$(ENTRY)_harness.goto",
      "$(FREERTOS_PLUS_TCP)/test/cbmc/stubs/cbmc.goto",
      "$(FREERTOS_PLUS_TCP)/source/FreeRTOS_BitConfig.goto",
      "$(FREERTOS_PLUS_TCP)/source/FreeRTOS_DHCPv6.goto"
    ]
}
